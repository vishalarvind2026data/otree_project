# ==========================================
# oTree Environment Configuration
# ==========================================

# 1. Local Development Settings
OTREE_ADMIN_PASSWORD=admin
OTREE_PRODUCTION=0
OTREE_AUTH_LEVEL=STUDY
OTREE_REST_KEY=secret_rest_key_12345
OTREE_BASE_URL=http://localhost:8000
DEBUG=1

# 2. Production Cloud Settings (Heroku / Render / AWS / Railway)
# When deploying live to the internet, set:
# OTREE_PRODUCTION=1
# OTREE_AUTH_LEVEL=STUDY
# OTREE_ADMIN_PASSWORD=SetAStrongPasswordHere
# DATABASE_URL=postgres://user:password@host:port/dbname
# OTREE_SECRET_KEY=generate-a-unique-random-secret-key-for-security

